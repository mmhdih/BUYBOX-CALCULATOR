#include <winver.h>

1 ICON "buybox.ico"

1 VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Buy Box Analyzer"
      VALUE "FileDescription",  "Buy Box Analyzer (portable)"
      VALUE "FileVersion",      "1.2.0"
      VALUE "InternalName",     "BuyBox"
      VALUE "OriginalFilename", "BuyBox.exe"
      VALUE "ProductName",      "Buy Box Analyzer"
      VALUE "ProductVersion",   "1.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
